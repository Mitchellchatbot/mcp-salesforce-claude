# ─── Server API key (gates this server's data/Claude endpoints) ──────────────
# Required. Callers must present this via "Authorization: Bearer <key>" or
# "x-api-key: <key>". Generate one with:  openssl rand -hex 32
API_KEY=your_long_random_api_key

# ─── Salesforce Connected App (OAuth2) ───────────────────────────────────────
# Create a Connected App in Salesforce Setup → App Manager → New Connected App
# Enable OAuth, add callback URL (any value for server flows), select scopes: api, refresh_token

SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# SF_LOGIN_URL defaults to https://login.salesforce.com
# Use https://test.salesforce.com for sandboxes
SF_LOGIN_URL=https://login.salesforce.com

# ─── Grant type: password (most common) ──────────────────────────────────────
# Requires "Resource Owner Password Credentials" enabled on the Connected App.
# In Setup → OAuth and OpenID Connect Settings, enable "Allow OAuth Username-Password Flows".
SF_USERNAME=your_salesforce_username@example.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token   # from Settings → Reset My Security Token

# ─── Grant type: client_credentials (no user login) ──────────────────────────
# Leave SF_USERNAME / SF_PASSWORD blank and enable "Client Credentials Flow" on
# the Connected App. A "Run As" user must be assigned on the Connected App policy.
# SF_USERNAME=
# SF_PASSWORD=

# ─── Alternative: pre-existing access token ──────────────────────────────────
# If you already have a token, set these two and omit everything above.
# SF_ACCESS_TOKEN=00Dxx...
# SF_INSTANCE_URL=https://yourorg.my.salesforce.com
